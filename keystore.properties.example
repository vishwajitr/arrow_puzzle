# Copy to ~/.arrow-escape-signing/keystore.properties (or keystore.properties here; it is git-ignored) and fill in.
# storeFile may be absolute. Back up the .jks and its passwords: you need them for every future update.
storeFile=/Users/YOU/.arrow-escape-signing/upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
